NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the /api/cron/* routes to write earnings and news data
# bypassing RLS. Never expose to the browser; never NEXT_PUBLIC_-prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Finnhub API key (free tier: https://finnhub.io).
# Used by /api/cron/refresh-earnings and /api/cron/refresh-news.
FINNHUB_API_KEY=

# Shared secret Vercel Cron sends in the Authorization header. Any random string.
CRON_SECRET=
