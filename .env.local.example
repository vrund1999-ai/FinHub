NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by /api/cron/refresh-earnings to write earnings data
# bypassing RLS. Never expose to the browser; never NEXT_PUBLIC_-prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Finnhub API key (free tier: https://finnhub.io). Used by /api/cron/refresh-earnings.
FINNHUB_API_KEY=

# FRED API key (free: https://fredaccount.stlouisfed.org/apikeys).
# Used by /api/cron/refresh-economic-calendar.
FRED_API_KEY=

# Shared secret Vercel Cron sends in the Authorization header. Any random string.
CRON_SECRET=
